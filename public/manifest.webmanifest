{
  "id": "/",
  "name": "Expense Tracker",
  "short_name": "Expenses",
  "description": "Production-ready Android mobile expense tracker with offline persistence, budgeting, analytics, and PIN security.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#10b981",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Expense",
      "url": "/?action=add-expense",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Add Income",
      "url": "/?action=add-income",
      "icons": [{ "src": "/icon.svg", "sizes": "192x192" }]
    }
  ]
}
